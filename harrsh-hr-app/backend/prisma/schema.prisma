// To switch to PostgreSQL:
// 1. Change provider from "sqlite" to "postgresql"
// 2. Update DATABASE_URL in .env to: postgresql://user:password@localhost:5432/harrsh_hr
// 3. Run: npx prisma migrate dev

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Organization {
  id              String    @id @default(uuid())
  name            String
  slug            String    @unique
  logoUrl         String?
  timezone        String    @default("Asia/Kolkata")
  currency        String    @default("INR")
  fiscalYearStart Int       @default(4)
  workingDays     String    @default("1,2,3,4,5")
  workStartTime   String    @default("09:00")
  workEndTime     String    @default("18:00")
  address         String?
  phone           String?
  email           String?
  website         String?
  isActive        Boolean   @default(true)
  maxEmployees    Int       @default(50)
  plan            String    @default("starter")
  planExpiresAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  users       User[]
  departments Department[]
  leaveTypes  LeaveType[]
  projects    Project[]
  holidays    Holiday[]
  settings    OrgSettings?
}

model OrgSettings {
  id                   String       @id @default(uuid())
  organizationId       String       @unique
  organization         Organization @relation(fields: [organizationId], references: [id])
  requireCheckInGPS    Boolean      @default(false)
  gpsRadius            Int          @default(200)
  officeLatitude       Float?
  officeLongitude      Float?
  requireSelfie        Boolean      @default(false)
  autoCheckOut         Boolean      @default(true)
  autoCheckOutTime     String       @default("19:00")
  leaveApprovalLevels  Int          @default(1)
  allowLeaveBackdate   Int          @default(0)
  payrollDay           Int          @default(25)
  emailNotifications   Boolean      @default(true)
  smtpHost             String?
  smtpPort             Int?
  smtpUser             String?
  smtpPass             String?
  updatedAt            DateTime     @updatedAt
}

model Holiday {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  date           DateTime
  type           String       @default("national")
  isRecurring    Boolean      @default(true)
  createdAt      DateTime     @default(now())
}

model User {
  id             String   @id @default(uuid())
  employeeId     String   @unique
  email          String   @unique
  passwordHash   String
  firstName      String
  lastName       String
  role           String   @default("EMPLOYEE")
  department     String?
  designation    String?
  managerId      String?
  phone          String?
  joinDate       DateTime?
  status         String   @default("ACTIVE")
  profilePhoto   String?
  organizationId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization    Organization? @relation(fields: [organizationId], references: [id])
  manager         User?         @relation("ManagerEmployee", fields: [managerId], references: [id])
  directReports   User[]        @relation("ManagerEmployee")

  refreshTokens     RefreshToken[]
  attendanceRecords AttendanceRecord[]
  leaveBalances     LeaveBalance[]
  leaveRequests     LeaveRequest[]      @relation("LeaveRequester")
  approvedLeaves    LeaveRequest[]      @relation("LeaveApprover")
  managerLeaves     LeaveRequest[]      @relation("LeaveManager")
  hrLeaves          LeaveRequest[]      @relation("LeaveHR")
  payrollRecords    PayrollRecord[]
  assignedTasks     Task[]              @relation("TaskAssignee")
  createdTasks      Task[]              @relation("TaskCreator")
  managedProjects   Project[]           @relation("ProjectManager")
  notifications     Notification[]
  documents         Document[]
  expenses          Expense[]           @relation("ExpenseOwner")
  approvedExpenses  Expense[]           @relation("ExpenseApprover")
  approvalRequests  ApprovalRequest[]   @relation("ApprovalRequester")
  pendingApprovals  ApprovalRequest[]   @relation("ApprovalApprover")
  departmentHead    Department[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AttendanceRecord {
  id                    String    @id @default(uuid())
  userId                String
  organizationId        String?
  date                  DateTime
  checkInTime           DateTime?
  checkOutTime          DateTime?
  status                String    @default("PRESENT")
  workingHours          Float?
  notes                 String?
  checkInLatitude       Float?
  checkInLongitude      Float?
  checkOutLatitude      Float?
  checkOutLongitude     Float?
  checkInAddress        String?
  selfieUrl             String?
  isRemote              Boolean   @default(false)
  regularizationStatus  String?
  regularizationReason  String?
  createdAt             DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model LeaveType {
  id             String   @id @default(uuid())
  name           String
  description    String?
  totalDays      Int
  carryForward   Boolean  @default(false)
  isPaid         Boolean  @default(true)
  color          String   @default("#3B82F6")
  organizationId String?
  createdAt      DateTime @default(now())

  organization  Organization? @relation(fields: [organizationId], references: [id])
  leaveBalances LeaveBalance[]
  leaveRequests LeaveRequest[]
}

model LeaveBalance {
  id             String   @id @default(uuid())
  userId         String
  leaveTypeId    String
  organizationId String?
  year           Int
  allocated      Float
  used           Float    @default(0)
  remaining      Float
  createdAt      DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@unique([userId, leaveTypeId, year])
}

model LeaveRequest {
  id               String    @id @default(uuid())
  userId           String
  leaveTypeId      String
  organizationId   String?
  startDate        DateTime
  endDate          DateTime
  totalDays        Float
  reason           String
  status           String    @default("PENDING")
  approvalLevel    Int       @default(0)
  managerId        String?
  hrReviewerId     String?
  approverId       String?
  approverComment  String?
  managerComment   String?
  hrComment        String?
  managerActionedAt DateTime?
  hrActionedAt     DateTime?
  cancelReason     String?
  attachmentUrl    String?
  appliedAt        DateTime  @default(now())
  actionedAt       DateTime?
  createdAt        DateTime  @default(now())

  user         User      @relation("LeaveRequester", fields: [userId], references: [id], onDelete: Cascade)
  leaveType    LeaveType @relation(fields: [leaveTypeId], references: [id])
  approver     User?     @relation("LeaveApprover", fields: [approverId], references: [id])
  manager      User?     @relation("LeaveManager", fields: [managerId], references: [id])
  hrReviewer   User?     @relation("LeaveHR", fields: [hrReviewerId], references: [id])
}

model PayrollRecord {
  id                  String    @id @default(uuid())
  userId              String
  organizationId      String?
  month               Int
  year                Int
  basicSalary         Float
  hra                 Float     @default(0)
  specialAllowance    Float     @default(0)
  transportAllowance  Float     @default(0)
  medicalAllowance    Float     @default(0)
  grossSalary         Float
  pfEmployee          Float     @default(0)
  pfEmployer          Float     @default(0)
  professionalTax     Float     @default(0)
  tds                 Float     @default(0)
  esiEmployee         Float     @default(0)
  totalDeductions     Float
  netSalary           Float
  status              String    @default("DRAFT")
  paidAt              DateTime?
  createdAt           DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month, year])
}

model Department {
  id             String   @id @default(uuid())
  name           String
  description    String?
  headId         String?
  organizationId String?
  createdAt      DateTime @default(now())

  head         User?         @relation(fields: [headId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])
}

model Project {
  id             String    @id @default(uuid())
  name           String
  description    String?
  status         String    @default("ACTIVE")
  startDate      DateTime?
  endDate        DateTime?
  managerId      String?
  organizationId String?
  budget         Float?
  progress       Int       @default(0)
  priority       String    @default("MEDIUM")
  createdAt      DateTime  @default(now())

  manager      User?         @relation("ProjectManager", fields: [managerId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])
  tasks        Task[]
}

model Task {
  id           String    @id @default(uuid())
  projectId    String
  title        String
  description  String?
  assignedToId String?
  assignedById String?
  status       String    @default("NOT_STARTED")
  priority     String    @default("MEDIUM")
  startDate    DateTime?
  dueDate      DateTime?
  progress     Int       @default(0)
  createdAt    DateTime  @default(now())

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedTo User?   @relation("TaskAssignee", fields: [assignedToId], references: [id])
  assignedBy User?   @relation("TaskCreator", fields: [assignedById], references: [id])
}

model ApprovalRequest {
  id                String    @id @default(uuid())
  requestType       String
  referenceId       String?
  requestedById     String
  currentApproverId String?
  organizationId    String?
  status            String    @default("PENDING")
  comments          String?
  createdAt         DateTime  @default(now())

  requestedBy     User  @relation("ApprovalRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  currentApprover User? @relation("ApprovalApprover", fields: [currentApproverId], references: [id])
}

model Notification {
  id             String   @id @default(uuid())
  userId         String
  organizationId String?
  title          String
  message        String
  type           String   @default("INFO")
  isRead         Boolean  @default(false)
  actionUrl      String?
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Document {
  id             String    @id @default(uuid())
  userId         String
  organizationId String?
  name           String
  type           String
  fileUrl        String
  fileSize       Int?
  mimeType       String?
  expiryDate     DateTime?
  status         String    @default("PENDING")
  verifiedById   String?
  verifierComment String?
  isDeleted      Boolean   @default(false)
  requestedById  String?
  uploadedAt     DateTime  @default(now())
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Expense {
  id          String    @id @default(uuid())
  userId      String
  title       String
  amount      Float
  category    String
  billDate    DateTime
  billNumber  String?
  description String?
  receiptUrl  String?
  status      String    @default("DRAFT")
  approverId  String?
  createdAt   DateTime  @default(now())

  user     User  @relation("ExpenseOwner", fields: [userId], references: [id], onDelete: Cascade)
  approver User? @relation("ExpenseApprover", fields: [approverId], references: [id])
}
