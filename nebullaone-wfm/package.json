{
  "name": "nebullaone-wfm",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @nebulla/api",
    "dev:web": "npm run dev -w @nebulla/web",
    "db:migrate": "npm run migrate -w @nebulla/api",
    "db:seed": "npm run seed -w @nebulla/api",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "start": "npm start -w @nebulla/api"
  },
  "engines": {
    "node": ">=20"
  }
}
